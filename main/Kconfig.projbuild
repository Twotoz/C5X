menu "C5X R0"

config C5X_CAPTURE_BYTES
    int "Bounded Q4/I4 capture size"
    range 4096 65536
    default 16384
    help
        Bytes captured from MODEM_DIAG through PARLIO for each R0 record.
        At 40 MS/s, 16384 bytes corresponds to about 409.6 us.

config C5X_TX_BURST_FRAMES
    int "Raw 802.11 frames per overlap burst"
    range 1 32
    default 8

config C5X_TX_MAX_POWER_QDBM
    int "Maximum Wi-Fi TX power, quarter-dBm units"
    range 8 40
    default 8
    help
        Kept deliberately low for the first self-interference experiments.
        8 corresponds to a nominal 2 dBm request.

endmenu
